@page
@model EventTicketSystem.Pages.Reservations.CreateModel
@{
    ViewData["Title"] = "チケット予約";
}
<h2>チケット予約</h2>

@if (Model.Event == null)
{
    <div class="alert alert-warning">イベントが見つかりません。</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@Model.Event.EventName</h5>
            <p class="mb-1">開催日: @Model.Event.EventDate.ToString("yyyy/MM/dd HH:mm")</p>
            <p class="mb-1">会場: @Model.Event.Venue</p>
            <p class="mb-1">料金: @Model.Event.Price 円 / 枚</p>
            <p class="mb-1">残席: @Model.Event.RemainingSeats 名</p>
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="EventId" />
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <div class="mb-3">
            <label class="form-label">予約枚数 *</label>
            <input asp-for="Quantity" type="number" min="1" max="@Model.Event.RemainingSeats" class="form-control" style="max-width:200px;" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>
        <p class="text-muted">合計金額はサーバー側で計算されます。</p>
        <button type="submit" class="btn btn-success">予約する</button>
        <a class="btn btn-outline-secondary" asp-page="/Events/Details" asp-route-id="@Model.Event.EventId">戻る</a>
    </form>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
