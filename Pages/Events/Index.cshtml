@page
@model EventTicketSystem.Pages.Events.IndexModel
@{
    ViewData["Title"] = "イベント検索・一覧";
}
<h2>イベント検索・一覧</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="Name" value="@Model.Name" class="form-control" placeholder="イベント名" />
    </div>
    <div class="col-md-3">
        <select name="CategoryId" class="form-select">
            <option value="0">カテゴリ（すべて）</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId)">@c.CategoryName</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <input type="date" name="Date" value="@Model.Date?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-3">
        <input type="text" name="Venue" value="@Model.Venue" class="form-control" placeholder="会場" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">検索</button>
        <a class="btn btn-outline-secondary" asp-page="/Events/Index">リセット</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-primary">
        <tr>
            <th>イベント名</th>
            <th>カテゴリ</th>
            <th>開催日</th>
            <th>会場</th>
            <th>料金</th>
            <th>残席</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model.Events)
        {
            <tr>
                <td>@e.EventName</td>
                <td>@e.CategoryName</td>
                <td>@e.EventDate.ToString("yyyy/MM/dd HH:mm")</td>
                <td>@e.Venue</td>
                <td>@e.Price 円</td>
                <td>@e.RemainingSeats / @e.Capacity</td>
                <td><a class="btn btn-sm btn-outline-primary" asp-page="/Events/Details" asp-route-id="@e.EventId">詳細</a></td>
            </tr>
        }
        @if (!Model.Events.Any())
        {
            <tr><td colspan="7" class="text-center text-muted">該当するイベントがありません。</td></tr>
        }
    </tbody>
</table>
