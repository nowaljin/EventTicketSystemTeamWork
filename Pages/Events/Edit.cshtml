@page "{id:int}"
@model EventTicketSystem.Pages.Events.EditModel
@{
    ViewData["Title"] = "イベント編集";
}
<h2>イベント編集</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
    <input type="hidden" asp-for="Event.EventId" />
    <div class="mb-3">
        <label class="form-label">イベント名 *</label>
        <input asp-for="Event.EventName" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">説明</label>
        <textarea asp-for="Event.Description" class="form-control" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">カテゴリ *</label>
        <select asp-for="Event.CategoryId" class="form-select">
            @foreach (var c in Model.Categories)
            {
                <option value="@c.CategoryId">@c.CategoryName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">開催日時 *</label>
        <input asp-for="Event.EventDate" type="datetime-local" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">会場 *</label>
        <input asp-for="Event.Venue" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">料金 (0円以上) *</label>
        <input asp-for="Event.Price" type="number" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">定員 (1以上) *</label>
        <input asp-for="Event.Capacity" type="number" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">状態</label>
        <select asp-for="Event.Status" class="form-select">
            <option value="公開中">公開中</option>
            <option value="公開停止">公開停止</option>
            <option value="終了">終了</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">更新</button>
    <a class="btn btn-outline-secondary" asp-page="/Admin/Events">戻る</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
