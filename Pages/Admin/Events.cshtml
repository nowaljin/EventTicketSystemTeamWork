@page
@model EventTicketSystem.Pages.Admin.EventsModel
@{
    ViewData["Title"] = "イベント管理";
}
<h2>イベント管理</h2>

<p>
    <a class="btn btn-primary" asp-page="/Events/Create">新規登録</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-primary">
        <tr>
            <th>ID</th>
            <th>イベント名</th>
            <th>開催日</th>
            <th>会場</th>
            <th>料金</th>
            <th>定員</th>
            <th>予約数</th>
            <th>残席</th>
            <th>状態</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model.Events)
        {
            <tr>
                <td>@e.EventId</td>
                <td>@e.EventName</td>
                <td>@e.EventDate.ToString("yyyy/MM/dd HH:mm")</td>
                <td>@e.Venue</td>
                <td>@e.Price 円</td>
                <td>@e.Capacity</td>
                <td>@e.ReservedCount</td>
                <td>@e.RemainingSeats</td>
                <td>@e.Status</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-page="/Events/Edit" asp-route-id="@e.EventId">編集</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Events/Details" asp-route-id="@e.EventId">詳細</a>
                    <form method="post" asp-page-handler="Stop" asp-route-id="@e.EventId" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-warning">公開停止</button>
                    </form>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@e.EventId" style="display:inline;" onsubmit="return confirm('完全削除しますか？');">
                        <button type="submit" class="btn btn-sm btn-danger">削除</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
